<div class="menu-page-container">
    <!-- Search & Category Filters -->
    <div class="menu-controls">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Search drinks, dishes, desserts..." />
        </div>

        <div class="filter-chips">
            <button class="chip active">All</button>
            <button class="chip">Main Dish</button>
            <button class="chip">Side Dish</button>
            <button class="chip">Drink / Dessert</button>
        </div>
    </div>

    <!-- Food Cards Grid -->
    <div class="food-grid">
        <!-- Card Item (Repeat in your @foreach loop) -->
        <div class="food-card">
            <div class="food-img-wrapper">
                <!-- Replace src with your image path: ~/images/americano.jpg -->
                <img src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=500&auto=format&fit=crop&q=60" alt="Americano" class="food-img" />
                <span class="category-badge">Drink</span>
            </div>

            <div class="food-info">
                <div class="food-header">
                    <h3 class="food-title">Americano</h3>
                    <span class="food-price">RM 9.90</span>
                </div>
                <p class="food-desc">Rich espresso diluted with hot water for a smooth, bold finish.</p>

                <div class="card-actions">
                    <!-- Action buttons (Admin / Staff) -->
                    <div class="admin-links">
                        <a href="#" class="link-btn">Detail</a>
                        <a href="#" class="link-btn">Edit</a>
                    </div>

                    <!-- Quantity & Add to Cart -->
                    <div class="order-controls">
                        <div class="qty-counter">
                            <button type="button" class="qty-btn">-</button>
                            <input type="number" value="1" min="1" class="qty-input" />
                            <button type="button" class="qty-btn">+</button>
                        </div>
                        <button class="add-to-cart-btn">Add</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sample Card 2 -->
        <div class="food-card">
            <div class="food-img-wrapper">
                <img src="https://images.unsplash.com/photo-1570968915860-54d5c301fa9f?w=500&auto=format&fit=crop&q=60" alt="Caffè Latte" class="food-img" />
                <span class="category-badge">Drink</span>
            </div>

            <div class="food-info">
                <div class="food-header">
                    <h3 class="food-title">Caffè Latte</h3>
                    <span class="food-price">RM 9.90</span>
                </div>
                <p class="food-desc">Espresso with a generous amount of silky steamed milk.</p>

                <div class="card-actions">
                    <div class="admin-links">
                        <a href="#" class="link-btn">Detail</a>
                        <a href="#" class="link-btn">Edit</a>
                    </div>
                    <div class="order-controls">
                        <div class="qty-counter">
                            <button type="button" class="qty-btn">-</button>
                            <input type="number" value="1" min="1" class="qty-input" />
                            <button type="button" class="qty-btn">+</button>
                        </div>
                        <button class="add-to-cart-btn">Add</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>