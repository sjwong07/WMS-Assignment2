@model List<Order>

@{
    ViewData["Title"] = "Order Maintenance";
    var statuses = new[] { "Pending", "Preparing", "Served", "Completed", "Cancelled" };
}

<div class="pixel-page">
    <div class="pixel-card">
        <h2 class="pixel-title"> Order Maintenance </h2>
        <p class="pixel-subtitle">Keep the kitchen running smoothly!</p>

        @if (!Model.Any())
        {
            <p class="pixel-empty">No orders to manage yet.</p>
        }
        else
        {
            <div class="pixel-table-wrap">
                <table class="pixel-table">
                    <thead>
                        <tr>
                            <th>Order Id</th>
                            <th>Customer</th>
                            <th>Dining / Table</th>
                            <th>Order Date</th>
                            <th>Payment</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.Id</td>
                                <td>@order.User?.Name</td>
                                <td>
                                    <!-- Display Dining Option & Table -->
                                    <span class="badge @(order.DiningOption == "Dine-In" ? "bg-warning text-dark" : "bg-info text-white")" style="padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">
                                        @(string.IsNullOrEmpty(order.DiningOption) ? "Dine-In" : order.DiningOption)
                                    </span>
                                    @if (string.IsNullOrEmpty(order.DiningOption) || order.DiningOption == "Dine-In")
                                    {
                                        <div class="small text-muted fw-bold" style="margin-top: 3px;">
                                            Table: @(order.Table?.Id ?? order.TableNumber ?? "N/A")
                                        </div>
                                    }
                                </td>
                                <td>@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td>@order.PaymentStatus</td>
                                <td>RM @order.TotalAmount.ToString("0.00")</td>
                                <td>
                                    <form asp-action="UpdateStatus" method="post" style="display:inline">
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <select name="status" class="pixel-select" onchange="this.form.submit()">
                                            @foreach (var s in statuses)
                                            {
                                                if (s == order.Status)
                                                {
                                                    <option value="@s" selected>@s</option>
                                                }
                                                else
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            }
                                        </select>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div style="text-align:center; margin-top: 20px;">
            <a href="/Product/Menu" class="pixel-back-link">← BACK</a>
        </div>
    </div>
</div>