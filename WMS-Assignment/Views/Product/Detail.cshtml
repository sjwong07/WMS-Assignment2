@model WMS_Assignment.Models.MenuItem

@{
    ViewBag.Title = "Product Detail";

    string itemId = Model?.Id?.Trim() ?? "";
    string itemName = Model?.Name?.Trim() ?? "";
    string dbCatName = Model?.Category?.Name?.Trim() ?? "";

    string categoryName = "Drink / Dessert";
    if (!string.IsNullOrWhiteSpace(dbCatName))
    {
        categoryName = dbCatName;
    }
    else
    {
        if (itemId.StartsWith("M", StringComparison.OrdinalIgnoreCase) || itemId.StartsWith("B", StringComparison.OrdinalIgnoreCase)) categoryName = "Main Dish";
        else if (itemId.StartsWith("S", StringComparison.OrdinalIgnoreCase)) categoryName = "Side Dish";
        else categoryName = "Drink / Dessert";
    }

    string fallbackSvg = categoryName.Contains("Main", StringComparison.OrdinalIgnoreCase) || itemId.StartsWith("M", StringComparison.OrdinalIgnoreCase)
        ? "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><style>.bowl{animation:bounce 2s ease-in-out infinite;}@keyframes bounce{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}</style><circle cx='100' cy='100' r='90' fill='%23f9f3ec'/><g class='bowl'><path d='M50 110 Q100 150 150 110 Z' fill='%23e5a96a'/><ellipse cx='100' cy='110' rx='50' ry='15' fill='%23d08c47'/><path d='M70 90 Q100 70 130 90' stroke='%23fff' stroke-width='4' fill='none' stroke-linecap='round'/></g><text x='50% ' y='170' text-anchor='middle' fill='%238a7b6b' font-family='sans-serif' font-size='14' font-weight='bold'>🍲 Fresh Dish</text></svg>"
        : categoryName.Contains("Side", StringComparison.OrdinalIgnoreCase) || itemId.StartsWith("S", StringComparison.OrdinalIgnoreCase)
        ? "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><style>.plate{animation:pulse 2s ease-in-out infinite;}@keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.05);}}</style><circle cx='100' cy='100' r='90' fill='%23f9f3ec'/><circle class='plate' cx='100' cy='100' r='55' fill='%23e5a96a'/><circle cx='100' cy='100' r='40' fill='%23f9f3ec'/><text x='50%' y='170' text-anchor='middle' fill='%238a7b6b' font-family='sans-serif' font-size='14' font-weight='bold'>🥗 Side Snack</text></svg>"
        : "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><style>.steam{animation:rise 2s ease-in-out infinite;}.cup{animation:tilt 3s ease-in-out infinite; transform-origin:center;}@keyframes rise{0%{transform:translateY(0); opacity:1;}100%{transform:translateY(-15px); opacity:0;}}@keyframes tilt{0%,100%{transform:rotate(0deg);}50%{transform:rotate(5deg);}}</style><circle cx='100' cy='100' r='90' fill='%23f9f3ec'/><g class='cup'><path d='M70 90 h60 v40 a20 20 0 0 1-20 20 h-20 a20 20 0 0 1-20-20 z' fill='%23e5a96a'/><path d='M130 100 h10 a10 10 0 0 1 10 10 v10 a10 10 0 0 1-10 10 h-10' stroke='%23e5a96a' stroke-width='6' fill='none'/></g><path class='steam' d='M90 70 q5 -10 0 -20' stroke='%23d08c47' stroke-width='3' fill='none' stroke-linecap='round'/><path class='steam' d='M110 75 q-5 -10 0 -20' stroke='%23d08c47' stroke-width='3' fill='none' stroke-linecap='round'/><text x='50%' y='170' text-anchor='middle' fill='%238a7b6b' font-family='sans-serif' font-size='14' font-weight='bold'>☕ Warm Brew</text></svg>";
}

<div class="product-detail-container">
    <div class="detail-gallery">
        @if (Model.Photos != null && Model.Photos.Any())
        {
            var first = Model.Photos.First();
            <img id="mainDetailImage" class="main-detail-img"
                 src="@Url.Content("~/" + first.PhotoURL.TrimStart('/'))"
                 alt="@Model.Name"
                 onerror="this.onerror=null; this.src='@fallbackSvg';" />

            <div class="thumb-strip">
                @foreach (var photo in Model.Photos)
                {
                    <img src="@Url.Content("~/" + photo.PhotoURL.TrimStart('/'))"
                         class="thumb-strip-img"
                         onclick="document.getElementById('mainDetailImage').src = this.src;"
                         onerror="this.onerror=null; this.src='@fallbackSvg';" />
                }
            </div>
        }
        else
        {
            <img class="main-detail-img" src="@fallbackSvg" alt="@Model.Name" />
        }
    </div>

    <div class="detail-info">
        <span class="item-code-tag">@Model.Id</span>
        <h2>@Model.Name</h2>
        <p class="detail-price">RM @Model.Price.ToString("0.00")</p>
        <p class="detail-desc">@Model.Description</p>
        <a asp-controller="Home" asp-action="Menu" class="btn-action btn-cancel">Back to Menu</a>
    </div>
</div>

<!-- Customer Reviews & Ratings Section -->
<div class="product-reviews-wrapper" style="max-width: 600px; margin: 3rem auto 0 auto;">
    <div class="reviews-header-block text-center mb-4">
        <h3>Customer Reviews & Ratings</h3>
        <p class="reviews-subtitle text-muted">Real feedback from verified patrons</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert mb-4" style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 12px 16px; border-radius: 12px; font-weight: 500; display: flex; align-items: center; gap: 8px; box-shadow: 0 2px 8px rgba(22, 101, 52, 0.05);">
            <span>✅</span> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert mb-4" style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 12px; font-weight: 500; display: flex; align-items: center; gap: 8px; box-shadow: 0 2px 8px rgba(153, 27, 27, 0.05);">
            <span>⚠️</span> @TempData["Error"]
        </div>
    }

    <div class="review-form-container" style="background: #ffffff; border: 1px solid #eee8e1; border-radius: 16px; padding: 1.75rem; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
        @if (Context.Session.GetString("User") != null)
        {
            <h4 style="font-size: 1.25rem; font-weight: 700; color: #2a261f; margin-bottom: 1.25rem;">Leave a Review</h4>
            <form asp-controller="Product" asp-action="SubmitReview" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="menuItemId" value="@Model.Id" />

                <div class="form-field-group mb-3">
                    <label class="form-label fw-semibold" style="font-size: 0.875rem; color: #2a261f;">Rating</label>
                    <select name="rating" class="form-select modern-select" style="border-radius: 10px; border-color: #e5dcd2;">
                        <option value="5">★★★★★ (5/5)</option>
                        <option value="4">★★★★☆ (4/5)</option>
                        <option value="3">★★★☆☆ (3/5)</option>
                        <option value="2">★★☆☆☆ (2/5)</option>
                        <option value="1">★☆☆☆☆ (1/5)</option>
                    </select>
                </div>

                <div class="form-field-group mb-3">
                    <label class="form-label fw-semibold" style="font-size: 0.875rem; color: #2a261f;">Your Thoughts</label>
                    <textarea name="comment" rows="4" class="form-control modern-textarea" placeholder="How was the flavor, temperature, or presentation?" maxlength="500" required style="border-radius: 10px; border-color: #e5dcd2; resize: none;"></textarea>
                </div>

                <button type="submit" class="w-100 py-2 btn-modern-submit" style="background: linear-gradient(135deg, #d98c5f, #b86a3e); color: #fff; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(217,140,95,0.25);">
                    Post Review
                </button>
            </form>
        }
        else
        {
            <div class="login-prompt-box text-center p-4">
                <p class="mb-3">Want to review this dish?</p>
                <a asp-controller="Security" asp-action="Login" class="btn btn-primary btn-login-redirect">Log in to Review</a>
            </div>
        }
    </div>
</div>