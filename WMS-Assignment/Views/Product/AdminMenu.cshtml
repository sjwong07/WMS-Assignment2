@model IEnumerable<MenuItem>

<table class="MenuItem">

    <tr>
        <th></th>
        <th>Item</th>
        <th>Description</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Create</th>
        
        <th>Update</th>
        <th>Delete</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td><input type="radio" name="menuItemId" value="@item.Id" /></td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>RM @item.Price</td>
            <td><input type="number" name="quantity" value="1" min="1" style="width:60px" /></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
    }

</table>

<button type="submit">Add To Cart</button>
