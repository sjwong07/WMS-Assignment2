
@model MenuItemVM



<table class="MenuItem">

    <tr>
        <th></th>
        <th>Item</th>
        <th>Description</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Category</th>
        <th>Detail</th>
        
    </tr>

    @foreach (var item in Model.MenuItems)
    {
        <tr>
            <td><input type="radio" name="menuItemId" value="@item.Id" /></td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>RM @item.Price</td>
            <td><input type="number" name="quantity" value="1" min="1" style="width:60px" /></td>
            <td>@item.Category.Name</td>
            <td><a href="/Product/Detail">Details</a></td>
            
        </tr>
    }

</table>

<button type="submit">Add To Cart</button>
