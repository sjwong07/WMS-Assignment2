@model dynamic

@{
    IEnumerable<dynamic>? items = null;

    if (Model != null)
    {
        try { items = Model.MenuItems; } catch { }
        if (items == null)
        {
            try { items = Model.Products; } catch { }
        }
        if (items == null && Model is IEnumerable<dynamic> list)
        {
            items = list;
        }
    }
}
<div class="food-grid">
    @if (items != null && items.Any())
    {
        @foreach (var item in items)
        {
            string itemId = Convert.ToString(item.Id ?? "").Trim();
            string itemName = Convert.ToString(item.Name ?? "").Trim();
            string categoryId = Convert.ToString(item.CategoryId ?? item.Category?.Id ?? "").Trim();
            string dbCatName = Convert.ToString(item.Category?.Name ?? "").Trim();

            // Resolve correct category name for display badge
            string categoryName = "Drink / Dessert";
            if (!string.IsNullOrWhiteSpace(dbCatName))
            {
                categoryName = dbCatName;
            }
            else
            {
                if (itemId.StartsWith("M", StringComparison.OrdinalIgnoreCase) || itemId.StartsWith("B", StringComparison.OrdinalIgnoreCase)) categoryName = "Main Dish";
                else if (itemId.StartsWith("S", StringComparison.OrdinalIgnoreCase)) categoryName = "Side Dish";
                else categoryName = "Drink / Dessert";
            }

            // Pick a matching animated food/drink SVG graphic based on category or item code
            string fallbackSvg = categoryName.Contains("Main", StringComparison.OrdinalIgnoreCase) || itemId.StartsWith("M", StringComparison.OrdinalIgnoreCase)
                ? "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><style>.bowl{animation:bounce 2s ease-in-out infinite;}@keyframes bounce{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}</style><circle cx='100' cy='100' r='90' fill='%23f9f3ec'/><g class='bowl'><path d='M50 110 Q100 150 150 110 Z' fill='%23e5a96a'/><ellipse cx='100' cy='110' rx='50' ry='15' fill='%23d08c47'/><path d='M70 90 Q100 70 130 90' stroke='%23fff' stroke-width='4' fill='none' stroke-linecap='round'/></g><text x='50% ' y='170' text-anchor='middle' fill='%238a7b6b' font-family='sans-serif' font-size='14' font-weight='bold'>🍲 Fresh Dish</text></svg>"
                : categoryName.Contains("Side", StringComparison.OrdinalIgnoreCase) || itemId.StartsWith("S", StringComparison.OrdinalIgnoreCase)
                ? "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><style>.plate{animation:pulse 2s ease-in-out infinite;}@keyframes pulse{0%,100%{transform:scale(1);}50%{transform:scale(1.05);}}</style><circle cx='100' cy='100' r='90' fill='%23f9f3ec'/><circle class='plate' cx='100' cy='100' r='55' fill='%23e5a96a'/><circle cx='100' cy='100' r='40' fill='%23f9f3ec'/><text x='50%' y='170' text-anchor='middle' fill='%238a7b6b' font-family='sans-serif' font-size='14' font-weight='bold'>🥗 Side Snack</text></svg>"
                : "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><style>.steam{animation:rise 2s ease-in-out infinite;}.cup{animation:tilt 3s ease-in-out infinite; transform-origin:center;}@keyframes rise{0%{transform:translateY(0); opacity:1;}100%{transform:translateY(-15px); opacity:0;}}@keyframes tilt{0%,100%{transform:rotate(0deg);}50%{transform:rotate(5deg);}}</style><circle cx='100' cy='100' r='90' fill='%23f9f3ec'/><g class='cup'><path d='M70 90 h60 v40 a20 20 0 0 1-20 20 h-20 a20 20 0 0 1-20-20 z' fill='%23e5a96a'/><path d='M130 100 h10 a10 10 0 0 1 10 10 v10 a10 10 0 0 1-10 10 h-10' stroke='%23e5a96a' stroke-width='6' fill='none'/></g><path class='steam' d='M90 70 q5 -10 0 -20' stroke='%23d08c47' stroke-width='3' fill='none' stroke-linecap='round'/><path class='steam' d='M110 75 q-5 -10 0 -20' stroke='%23d08c47' stroke-width='3' fill='none' stroke-linecap='round'/><text x='50%' y='170' text-anchor='middle' fill='%238a7b6b' font-family='sans-serif' font-size='14' font-weight='bold'>☕ Warm Brew</text></svg>";

            string photoUrl = fallbackSvg;

            try
            {
                string directRaw = Convert.ToString(item.PhotoURL ?? "").Replace("\\", "/").Trim();
                if (!string.IsNullOrWhiteSpace(directRaw))
                {
                    photoUrl = directRaw.StartsWith("~/") ? Url.Content(directRaw) : (directRaw.StartsWith("/") ? directRaw : "~/" + directRaw.TrimStart('/'));
                    photoUrl = Url.Content(photoUrl);
                }
                else
                {
                    var firstPhoto = ((IEnumerable<dynamic>)item.Photos)?.Cast<dynamic>().FirstOrDefault();
                    string raw = firstPhoto != null ? Convert.ToString(firstPhoto.PhotoURL)?.Replace("\\", "/")?.Trim() : null;
                    if (!string.IsNullOrWhiteSpace(raw))
                    {
                        string resolvedRaw = raw.StartsWith("~/") ? raw : (raw.StartsWith("/") ? raw : "~/" + raw.TrimStart('/'));
                        photoUrl = Url.Content(resolvedRaw);
                    }
                }
            }
            catch { }

            decimal price = 0;
            try { price = Convert.ToDecimal(item.Price); } catch { }

            <div class="food-card"
                 data-id="@itemId"
                 data-name="@itemName"
                 data-category-id="@categoryId"
                 data-category-name="@categoryName"
                 data-price="@price">

                <!-- Image with Category Badge -->
                <div class="food-img-wrapper" style="position: relative; height: 180px; background-color: #f9f3ec;">
                    <img src="@photoUrl"
                         alt="@itemName"
                         class="food-img"
                         style="width: 100%; height: 180px; object-fit: cover; display: block;"
                         onerror="this.onerror=null; this.src='@fallbackSvg';" />

                    <span class="category-badge">@categoryName</span>
                </div>

                <!-- Product Details -->
                <div class="food-info">
                    <div class="food-header" style="align-items: center;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <h3 class="food-title" style="margin: 0;">@itemName</h3>
                        </div>
                        <div class="food-price">RM @price.ToString("0.00")</div>
                    </div>

                    <p class="food-desc">@item.Description</p>

                    <!-- Bottom Actions -->
                    <div class="card-actions" style="justify-content: flex-end;">
                        <form asp-controller="Home" asp-action="AddToOrder" method="post" class="order-controls">
                            <input type="hidden" name="menuItemId" value="@itemId" />
                            <input type="hidden" name="tableId" value="T01" />

                            <a asp-controller="Product" asp-action="Detail" asp-route-id="@itemId" class="btn-action btn-detail">
                                Detail
                            </a>

                            <div class="qty-counter">
                                <button type="button" class="qty-btn" onclick="decrementQty('@itemId')">-</button>
                                <input type="number" name="quantity" id="qty-@itemId" class="qty-input" value="1" min="1" max="99" readonly />
                                <button type="button" class="qty-btn" onclick="incrementQty('@itemId')">+</button>
                            </div>

                            <button type="submit" class="add-to-cart-btn">Add</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div style="grid-column: 1 / -1; text-align: center; padding: 3rem; color: #8a7b6b; font-weight: 600;">
            No food items found matching your search.
        </div>
    }
</div>