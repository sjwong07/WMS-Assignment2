


@{
    ViewBag.Title = "Menu";
}

@model MenuItemVM

<form data-ajax="true"
      data-ajax-method="get"
      data-ajax-update="#target">

    <div>
        <input type="text" name="search" placeholder="Search For Product" />
    </div>

    @foreach (var c in Model.FoodCategories)
    {
        <label><input type="checkbox" name="category" value="@c.Name">@c.Name </label>
    }

</form>


<table class="MenuItem">

    <tr>
        <th></th>
        <th>Item</th>
        <th>Description</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Create</th>
        <th>Detail</th>
        <th>Update</th>
        <th>Delete</th>
    </tr>

    @foreach (var item in Model.MenuItems)
    {
        <tr>
            <td><input type="radio" name="menuItemId" value="@item.Id" /></td>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>RM @item.Price.ToString("0.00")</td>
            <td><input type="number" name="quantity" value="1" min="1" style="width:60px" /></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
    }

</table>

<button type="submit">Add To Cart</button>


 <partial name="_A" model = "Model">