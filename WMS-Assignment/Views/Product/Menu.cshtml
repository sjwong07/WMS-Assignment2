@model MenuItemVM

@{
    ViewBag.Title = "Menu";
}

<div class="menu-page-container">
    <div class="menu-controls">
        <!-- Search Bar -->
        <div class="search-box">
            <i>🔍</i>
            <input type="search" 
                   id="menuSearchInput" 
                   placeholder="Search For Product..." 
                   autocomplete="off" 
                   oninput="filterMenuItems()" />
        </div>

        <!-- Filter Chips -->
        <div class="filter-chips">
            <button type="button" class="chip active" onclick="setCategoryFilter('ALL', this)">
                All
            </button>
            <button type="button" class="chip" onclick="setCategoryFilter('MAIN', this)">
                Main Dish
            </button>
            <button type="button" class="chip" onclick="setCategoryFilter('SIDE', this)">
                Side Dish
            </button>
            <button type="button" class="chip" onclick="setCategoryFilter('DRINK', this)">
                Drink / Dessert
            </button>
        </div>

        <!-- Price Range Inputs -->
        <div class="price-filters">
            <input type="number" 
                   id="minPriceInput" 
                   min="0" 
                   step="0.5" 
                   placeholder="Min (RM)" 
                   oninput="filterMenuItems()" />
            <span>—</span>
            <input type="number" 
                   id="maxPriceInput" 
                   min="0" 
                   step="0.5" 
                   placeholder="Max (RM)" 
                   oninput="filterMenuItems()" />
        </div>
    </div>

    <!-- Target Cards Container -->
    <div id="target">
        <partial name="_A" model="Model" />
    </div>
</div>

@section foot {
    <script>
        let activeCategory = 'ALL';

        function setCategoryFilter(categoryKey, element) {
            activeCategory = categoryKey;

            // Highlight active chip
            document.querySelectorAll('.filter-chips .chip').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');

            filterMenuItems();
        }

        function filterMenuItems() {
            const searchQuery = (document.getElementById('menuSearchInput').value || '').toLowerCase().trim();
            const minPrice = parseFloat(document.getElementById('minPriceInput').value) || 0;
            const maxPriceVal = parseFloat(document.getElementById('maxPriceInput').value);
            const maxPrice = isNaN(maxPriceVal) ? Infinity : maxPriceVal;

            const cards = document.querySelectorAll('.food-grid .food-card');

            cards.forEach(card => {
                const id = (card.getAttribute('data-id') || '').toLowerCase().trim();
                const name = (card.getAttribute('data-name') || '').toLowerCase().trim();
                const catName = (card.getAttribute('data-category-name') || '').toLowerCase().trim();
                const catId = (card.getAttribute('data-category-id') || '').toLowerCase().trim();
                const price = parseFloat(card.getAttribute('data-price')) || 0;

                // 1. Search Query Filter
                const matchesSearch = name.includes(searchQuery) || id.includes(searchQuery);

                // 2. Comprehensive Category Filter
                let matchesCategory = false;
                if (activeCategory === 'ALL') {
                    matchesCategory = true;
                } else if (activeCategory === 'MAIN') {
                    matchesCategory = catName.includes('main') || id.startsWith('m') || id.startsWith('b') || catId.includes('main') || catId === 'c1' || catId === '1';
                } else if (activeCategory === 'SIDE') {
                    matchesCategory = catName.includes('side') || id.startsWith('s') || catId.includes('side') || catId === 'c2' || catId === '2';
                } else if (activeCategory === 'DRINK') {
                    matchesCategory = catName.includes('drink') || catName.includes('dessert') || catName.includes('beverage') || id.startsWith('d') || catId.includes('drink') || catId === 'c3' || catId === '3';
                }

                // 3. Price Filter
                const matchesPrice = price >= minPrice && price <= maxPrice;

                // Display or Hide Card
                if (matchesSearch && matchesCategory && matchesPrice) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function incrementQty(id) {
            const input = document.getElementById('qty-' + id);
            if (input) {
                input.value = parseInt(input.value || 1) + 1;
            }
        }

        function decrementQty(id) {
            const input = document.getElementById('qty-' + id);
            if (input && parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }
    </script>
}