@model MenuItemVM

@{
    ViewBag.Title = "Menu";
}

<form data-ajax="true"
      data-ajax-update="#target"
      data-ajax-loading="#loader">

    @Html.TextBox("search", "",
                  new { id = "name" , type = "search", autofocus = "", data_trim = "",
                  placeholder = "Search For Product" })

    <label><input id="All" type="checkbox" />All</label>

    @foreach (var p in Model.FoodCategories)
    {
        <label><input type="checkbox" name="category" value="@p.Id">@p.Name </label>
    }


    @Html.TextBox("minPrice", "", new
    {
       id = "minPrice", type = "number",autofocus = "",data_trim = "",placeholder = "Min Price"
    })

    <div></div>

    @Html.TextBox("maxPrice", "", new
    {
       id= "maxPrice", type = "number",autofocus = "",data_trim = "",placeholder = "Max Price"
    })



</form>

<div id="target">
    <partial name="_A" model="Model">
    </div>

    
   @section foot {
        <script>
            let timer = null;

            $('#name,#minPrice,#maxPrice').on('input', e => {
                clearTimeout(timer);
                timer = setTimeout(() => $(e.target.form).submit(), 500);
            });

            $('input[name="category"]').on('change', e =>{
                clearTimeout(timer);
                timer = setTimeout(() => $(e.target.form).submit(), 1500);
            });

            $('#All').on('change',e => {
                if(e.target.checked){
                    $('input[name="category"]').prop('check',false);
                    
                }
               

            });
        </script>


    }
    
