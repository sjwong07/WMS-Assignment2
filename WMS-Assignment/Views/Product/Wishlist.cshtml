@model List<WMS_Assignment.Models.MenuItem>

@{
    ViewData["Title"] = "My Wishlist";
}

<div class="menu-page-container">
    <div class="cart-header-title">
        <h2>❤️ My Favorite & Saved Items</h2>
        <a href="/Product/Menu" class="btn-continue-shopping">← Back to Menu</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="food-grid">
            @foreach (var item in Model)
            {
                <div class="food-card">
                    <div class="food-img-wrapper" style="position: relative; height: 180px; background: #f9f3ec;">
                        <img src="/photos/@($"{item.Id}.jpg")" class="food-img" alt="@item.Name" style="width:100%; height:180px; object-fit:cover;" onerror="this.src='/images/default-food.png';" />
                        <span class="category-badge">@(item.Category?.Name ?? "Café Item")</span>
                    </div>
                    <div class="food-info">
                        <div class="food-header">
                            <h3 class="food-title">@item.Name</h3>
                            <span class="food-price">RM @item.Price.ToString("0.00")</span>
                        </div>
                        <p class="food-desc">@item.Description</p>
                        
                        <div class="card-actions" style="justify-content: flex-end;">
                            <form asp-controller="Home" asp-action="AddToOrder" method="post" class="order-controls">
                                <input type="hidden" name="menuItemId" value="@item.Id" />
                                <input type="hidden" name="tableId" value="T01" />
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id" class="btn-action btn-detail">Detail</a>
                                <button type="submit" class="add-to-cart-btn">Quick Add</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-cart-box" style="text-align: center; padding: 4rem;">
            <div style="font-size: 3.5rem; margin-bottom: 1rem;">🤍</div>
            <h3>No saved favorites yet!</h3>
            <p>Heart your favorite coffee or food items on the menu for quick access.</p>
            <a href="/Product/Menu" class="add-to-cart-btn btn-browse-menu" style="text-decoration:none; display:inline-block; margin-top:1rem;">Browse Menu</a>
        </div>
    }
</div>