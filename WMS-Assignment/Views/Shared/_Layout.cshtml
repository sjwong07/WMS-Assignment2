@using Microsoft.AspNetCore.Http
@{
    var username = Context.Session.GetString("User")
                ?? Context.Session.GetString("Username")
                ?? (User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : null);

    var userRole = Context.Session.GetString("Role") ?? "Member";

    var rawPhoto = Context.Session.GetString("UserPhoto")
                ?? Context.Session.GetString("Photo")
                ?? Context.Session.GetString("PhotoURL");

    string userPhotoUrl = "/images/default-avatar.png";

    if (!string.IsNullOrEmpty(rawPhoto))
    {
        userPhotoUrl = rawPhoto.StartsWith("/") || rawPhoto.StartsWith("http")
            ? rawPhoto
            : $"/photos/{rawPhoto}";
    }
    else if (!string.IsNullOrEmpty(username))
    {
        userPhotoUrl = $"/photos/{username}.jpg";
    }

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    bool isAuthPage = string.Equals(currentController, "Security", StringComparison.OrdinalIgnoreCase)
                   && (string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase)
                       || string.Equals(currentAction, "Register", StringComparison.OrdinalIgnoreCase)
                       || string.Equals(currentAction, "ForgotPassword", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - WagEat</title>

    <!-- External Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminMenu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forgotpassword.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-form.css" asp-append-version="true" />

    <!-- Hide Google Translate Default Top Bar -->
    <style>
        .goog-te-banner-frame.skiptranslate,
        .goog-te-banner-frame,
        #goog-gt-tt,
        .goog-te-balloon-frame {
            display: none !important;
        }

        body {
            top: 0px !important;
        }

        .skiptranslate {
            display: none !important;
        }
    </style>
</head>
<body>

    <!-- Hidden Google Translate Element -->
    <div id="google_translate_element" style="display:none;"></div>

    <!-- Header / Navbar -->
    <header class="navbar-main">
        <!-- Logo -->
        <a href="/" class="brand-logo notranslate">
            <span>☕</span> WagEat •
        </a>

        <!-- Navigation Links -->
        <ul class="nav-center-links">
            <li><a href="/">🏠 Home</a></li>
            <li><a href="/Product/Menu">📋 Menu</a></li>
                 
             <li> <a href="/Admin/AdminMenu">Admin MEnu</a></li>
                
             <li><a href="/Home/Cart">🛒 Cart</a></li>
        </ul>

        <!-- Right Side User Section -->
        <div class="nav-right-actions">
            @if (!string.IsNullOrEmpty(username))
            {
                <div class="nav-user-pill notranslate" id="userDropdownTrigger" onclick="toggleUserDropdown(event)">
                    <img src="@userPhotoUrl"
                         alt="@username"
                         class="user-avatar-img"
                         onerror="this.onerror=null; this.src='/uploads/@(username).jpg'; this.onerror=function(){this.src='/images/default-avatar.png';};" />

                    <span class="username-text">@username</span>

                    <!-- Language Selector Dropdown -->
                    <select id="langSelector" class="lang-select" onclick="event.stopPropagation()" onmousedown="event.stopPropagation()" onchange="changeLanguage(this.value, event)">
                        <option value="en">EN</option>
                        <option value="ms">BM</option>
                        <option value="zh-CN">中文</option>
                    </select>

                    <span class="caret-icon">▼</span>

                    <!-- Dropdown Content -->
                    <div class="user-dropdown-menu" id="userMenu">
                        <a href="/Member/Profile">
                            <span>👤</span> Profile
                        </a>
                        @if (userRole == "Admin")
                        {
                            <a href="/Admin/Dashboard">
                                <span>⚙️</span> Dashboard
                            </a>
                        }
                        <div class="user-dropdown-divider"></div>
                        <a href="/Security/Logout" class="logout-btn">
                            <span>🚪</span> Logout
                        </a>
                    </div>
                </div>
            }
            else if (!isAuthPage)
            {
                <a href="/Security/Login" class="btn btn-sm btn-primary" style="text-decoration:none;">Login</a>
            }
        </div>
    </header>

    <!-- Main Content Container -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Google Translate Script -->
    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,ms,zh-CN',
                autoDisplay: false
            }, 'google_translate_element');
        }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <!-- Custom Handlers -->
    <script>
        function toggleUserDropdown(event) {
            if (event.target.tagName.toLowerCase() === 'select' || event.target.tagName.toLowerCase() === 'option') {
                return;
            }
            event.stopPropagation();
            const dropdown = document.getElementById('userMenu');
            if (dropdown) {
                dropdown.classList.toggle('show');
            }
        }

        function changeLanguage(langCode, event) {
            if (event) event.stopPropagation();

            const cookieValue = '/en/' + langCode;
            document.cookie = 'googtrans=' + cookieValue + '; path=/;';
            document.cookie = 'googtrans=' + cookieValue + '; path=/; domain=' + window.location.hostname;
            localStorage.setItem('selectedLanguage', langCode);

            const selectElement = document.querySelector('.goog-te-combo');
            if (selectElement) {
                selectElement.value = langCode;
                selectElement.dispatchEvent(new Event('change'));
            } else {
                window.location.reload();
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const savedLang = localStorage.getItem('selectedLanguage') || 'en';
            const selector = document.getElementById('langSelector');
            if (selector) {
                selector.value = savedLang;
            }
        });

        document.addEventListener('click', function (e) {
            const dropdown = document.getElementById('userMenu');
            const trigger = document.getElementById('userDropdownTrigger');
            if (dropdown && trigger && !trigger.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("foot", required: false)
</body>
</html>