@using Microsoft.AspNetCore.Http
@inject WMS_Assignment.Models.DB db
@{
    var username = User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : null;
    var userRole = User.IsInRole("Admin") ? "Admin" : (User.IsInRole("SuperAdmin") ? "SuperAdmin" : "Member");

    // Retrieve photo directly from the database to ensure it's always up-to-date
    string? rawPhoto = null;
    if (!string.IsNullOrEmpty(username))
    {
        var userRecord = db.Users.FirstOrDefault(u => u.Username != null && u.Username.ToLower() == username.ToLower());
        rawPhoto = userRecord?.PhotoURL;
    }

    if (string.IsNullOrEmpty(rawPhoto))
    {
        rawPhoto = User.FindFirst("PhotoURL")?.Value;
    }

    // Default to UI-avatars fallback
    string userPhotoUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(username ?? "User")}&background=E5A96A&color=fff";

    if (!string.IsNullOrEmpty(rawPhoto))
    {
        var clean = rawPhoto.Replace("\\", "/").Trim();
        if (clean.StartsWith("photos/", StringComparison.OrdinalIgnoreCase))
        {
            userPhotoUrl = "/" + clean;
        }
        else if (clean.StartsWith("/"))
        {
            userPhotoUrl = clean;
        }
        else
        {
            userPhotoUrl = "/photos/" + clean;
        }
    }

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    bool isAuthPage = string.Equals(currentController, "Security", StringComparison.OrdinalIgnoreCase)
                    && (string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(currentAction, "Register", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(currentAction, "ForgotPassword", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - WagEat</title>

    <!-- Cropper.js CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />

    <!-- External Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminMenu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forgotpassword.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/UpdatePassword.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/BanAdminMember.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/BannedUser.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/AdminMemberList.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/RegisterAdmin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/CreateUpdateProduct.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Detail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/order-tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />
</head>
<body>

    <!-- Hidden Google Translate Element -->
    <div id="google_translate_element" style="display:none;"></div>

    <!-- Header / Navbar -->
    <header class="navbar-main stacked-navbar">
        <!-- Top Row: Logo & User Profile / Login -->
        <div class="navbar-top-row">
            <a href="/" class="brand-logo notranslate">
                <span>☕</span> WagEat •
            </a>

            <!-- Right Side User Section -->
            <div class="nav-right-actions">
                @if (!string.IsNullOrEmpty(username))
                {
                    <div class="nav-user-pill notranslate" id="userDropdownTrigger" onclick="toggleUserDropdown(event)">
                        <img src="@userPhotoUrl"
                             alt="@username"
                             class="user-avatar-img"
                             onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(username ?? "User")&background=E5A96A&color=fff';" />

                        <span class="username-text">@username</span>

                        <!-- Language Selector Dropdown -->
                        <select id="langSelector" class="lang-select" onclick="event.stopPropagation()" onmousedown="event.stopPropagation()" onchange="changeLanguage(this.value, event)">
                            <option value="en">EN</option>
                            <option value="ms">BM</option>
                            <option value="zh-CN">中文</option>
                        </select>

                        <span class="caret-icon">▼</span>

                        <!-- Dropdown Content -->
                        <div class="user-dropdown-menu" id="userMenu">
                            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                            {
                                <a href="/Admin/Profile">
                                    <span>👤</span> Profile
                                </a>
                                <a href="/Admin/Dashboard">
                                    <span>⚙️</span> Dashboard
                                </a>
                            }
                            else
                            {
                                <a href="/Member/Profile">
                                    <span>👤</span> Profile
                                </a>
                                <a href="/Member/Dashboard">
                                    <span>📊</span> Dashboard
                                </a>
                            }

                            <div class="user-dropdown-divider"></div>

                            <a href="/Member/UpdatePassword" class="UpdatePassword-btn">
                                <span>🔑</span> Update Password
                            </a>

                            <a href="/Security/Logout" class="logout-btn">
                                <span></span> Logout
                            </a>
                        </div>
                    </div>
                }
                else if (!isAuthPage)
                {
                    <a href="/Security/Login" class="btn btn-sm btn-primary" style="text-decoration:none;">Login</a>
                }
            </div>
        </div>

        <!-- Bottom Row: Navigation Links Function Bar -->
        <div class="navbar-bottom-row">
            <ul class="nav-center-links">
                <li><a href="/"> Home</a></li>
                <li><a href="/Product/Menu"> Menu</a></li>
                <li><a href="/Order/History"> Order History</a></li>

                @if (User.IsInRole("Member") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <li><a href="/Home/Cart"> Cart</a></li>
                  
                }

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <li><a href="/Admin/AdminMenu">Admin Menu</a></li>
                    <li><a href="/Order/Maintenance"> Order Maintenance</a></li>
                    <li><a href="/Order/Report">Revenue Report</a></li>
                    <li><a href="/Admin/BannedUser">Ban List</a></li>
                    <li><a href="/Admin/MemberList">Member List</a></li>
                }

                @if (User.IsInRole("SuperAdmin"))
                {
                    <li><a href="/Admin/AdminList"><span></span> Admin List</a></li>
                }
            </ul>
        </div>
    </header>

    <!-- Main Content Container -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Cropper.js JavaScript Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <!-- Google Translate Script -->
    <script type="text/javascript">
            function googleTranslateElementInit() {
                new google.translate.TranslateElement({
                    pageLanguage: 'en',
                    includedLanguages: 'en,ms,zh-CN',
                    autoDisplay: false
                }, 'google_translate_element');
            }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <!-- Custom Handlers -->
    <script>
            function toggleUserDropdown(event) {
                if (event.target.tagName.toLowerCase() === 'select' || event.target.tagName.toLowerCase() === 'option') {
                    return;
                }
                event.stopPropagation();
                const dropdown = document.getElementById('userMenu');
                if (dropdown) {
                    dropdown.classList.toggle('show');
                }
            }

            function changeLanguage(langCode, event) {
                if (event) event.stopPropagation();

                const cookieValue = '/en/' + langCode;
                document.cookie = 'googtrans=' + cookieValue + '; path=/;';
                document.cookie = 'googtrans=' + cookieValue + '; path=/; domain=' + window.location.hostname;
                localStorage.setItem('selectedLanguage', langCode);

                const selectElement = document.querySelector('.goog-te-combo');
                if (selectElement) {
                    selectElement.value = langCode;
                    selectElement.dispatchEvent(new Event('change'));
                } else {
                    window.location.reload();
                }
            }

            window.addEventListener('DOMContentLoaded', () => {
                const savedLang = localStorage.getItem('selectedLanguage') || 'en';
                const selector = document.getElementById('langSelector');
                if (selector) {
                    selector.value = savedLang;
                }
            });

            document.addEventListener('click', function(e) {
                const dropdown = document.getElementById('userMenu');
                const trigger = document.getElementById('userDropdownTrigger');
                if (dropdown && trigger && !trigger.contains(e.target)) {
                    dropdown.classList.remove('show');
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("foot", required: false)
</body>
</html>