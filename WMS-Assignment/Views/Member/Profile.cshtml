@model WMS_Assignment.Models.UpdateProfileVM

@{
    ViewBag.Title = "My Profile";
}



<div class="profile-page-wrapper">
    <div class="profile-card">

        @if (TempData["Success"] != null)
        {
            <div class="profile-success-msg">
                ✓ @TempData["Success"]
            </div>
        }

        <form asp-controller="Member" asp-action="Profile" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <!-- Profile Photo & Live Preview -->
            <div class="avatar-block">
                <div class="avatar-wrap">
                    @if (!string.IsNullOrEmpty(Model.CurrentPhotoURL))
                    {
                        <img id="avatarPreview" class="avatar-img" src="~/photos/@Model.CurrentPhotoURL" alt="Profile Photo" />
                    }
                    else
                    {
                        <div id="avatarPlaceholder" class="avatar-placeholder">
                            @(Model.Username.Length >= 2 ? Model.Username.Substring(0, 2).ToUpper() : "ME")
                        </div>
                        <img id="avatarPreview" class="avatar-img hidden" src="#" alt="Profile Photo" />
                    }

                    <label for="photoUpload" title="Change Photo" class="avatar-upload-btn">
                        📷
                    </label>
                    <input type="file" id="photoUpload" asp-for="Photo" accept="image/*" style="display: none;" onchange="previewImage(this);" />
                </div>

                <h2 class="profile-username">@Model.Username</h2>
                <span class="profile-role-badge">Member</span>
            </div>

            <!-- Username Field -->
            <div class="profile-field">
                <label>Username</label>
                <input type="text" asp-for="Username" required />
                <span asp-validation-for="Username" class="profile-field-error"></span>
            </div>

            <!-- Email Field -->
            <div class="profile-field email-field">
                <label>Email Address</label>
                <input type="email" asp-for="Email" required />
                <span asp-validation-for="Email" class="profile-field-error"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="profile-save-btn">
                Save Changes
            </button>
        </form>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('avatarPreview');
                const placeholder = document.getElementById('avatarPlaceholder');

                preview.src = e.target.result;
                preview.classList.remove('hidden');

                if (placeholder) {
                    placeholder.style.display = 'none';
                }
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>