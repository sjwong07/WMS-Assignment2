@model ProductInsertVM

<div class="product-form-container">

    <h2>Create Menu Item</h2>

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="form-photo-preview">
            <img id="photoPreview" src="~/images/no-photo.png" alt="Photo preview" />
        </div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="description"></label>
            <textarea asp-for="description" class="form-control"></textarea>
            <span asp-validation-for="description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CategoryId"></label>
            <select asp-for="CategoryId" class="form-control"
                    asp-items="@(new SelectList(Model.FoodCategories, "Id", "Name"))">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Photos"></label>
            <input asp-for="Photos" type="file" multiple accept="image/*" class="form-control" onchange="previewPhoto(event)" />
            <span asp-validation-for="Photos" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-action btn-create">Create</button>
            <a asp-action="AdminMenu" asp-controller="Admin" class="btn-action btn-cancel">Cancel</a>
        </div>

    </form>

</div>

<script>
    function previewPhoto(event) {
        const file = event.target.files[0];
        if (!file || file.length === 0) return;
        const preview = document.getElementById('photoPreview');
        preview.src = URL.createObjectURL(file);
    }
</script>