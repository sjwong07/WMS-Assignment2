@model BanVM

<div class="ban-user-container">
    <h2>Banned Member: @Model.Username</h2>

    <form asp-controller="Admin" asp-action="BanMember" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Username" />

        <div class="form-group">
            <label asp-for="BanReason">Ban</label>
            <textarea asp-for="BanReason" class="form-control" rows="4"></textarea>
            <span asp-validation-for="BanReason" class="text-danger"></span>
        </div>

        <div class="ban-actions">
            <button type="submit" class="btn-confirm-ban">Confirm Ban</button>
            <a asp-action="AdminList" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>