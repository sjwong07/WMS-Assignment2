@model IEnumerable<MenuItem>

<div class="admin-menu-container">

    <div class="admin-menu-header">
        <h2>Menu Management</h2>
        <a asp-action="Create" asp-controller="Admin" class="btn-action btn-create">
            + Create New Item
        </a>
    </div>

    <table class="admin-table">

        <tr>
            <th></th>
            <th>Item</th>
            <th>Description</th>
            <th>Price</th>
            <th>Qty</th>
            <th>Delete</th>
            <th>Update</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td><input type="radio" name="menuItemId" value="@item.Id" /></td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>RM @item.Price</td>
                <td><input type="number" name="quantity" value="1" min="1" class="admin-qty-input" /></td>

                <td>
                    <form asp-action="Delete" asp-controller="Admin" asp-route-id="@item.Id" method="post"
                          class="delete-form">
                        <button type="submit" class="btn-action btn-delete">Delete</button>
                    </form>
                </td>
                <td>
                    <a asp-action="Update"
                       asp-controller="Admin"
                       asp-route-id="@item.Id"
                       class="btn-action btn-update">
                        ✏️ Update
                    </a>
                </td>
            </tr>
        }

    </table>

</div>