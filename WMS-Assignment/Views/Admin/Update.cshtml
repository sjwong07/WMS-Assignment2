@model ProductUpdateVM

@{
    var hasPhoto = Model?.CurrentPhotoURL != null && Model.CurrentPhotoURL.Count > 0;
}

<div class="product-form-container">

    <h2>Update Menu Item</h2>
    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="Update" asp-controller="Admin" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CurrentPhotoURL" />

        <div class="form-photo-preview" id="photoPreviewContainer">
            @if (hasPhoto)
            {
                foreach (var photo in Model.CurrentPhotoURL)
                {
                    <div class="photo-item">
                        <img src="@Url.Content("~/" + photo.PhotoURL.TrimStart('/'))" class="preview-thumb" alt="Existing photo" />
                        <button type="submit" form="deleteForm_@photo.Id" class="delete-photo-btn">✕</button>
                    </div>
                }
            }
            else
            {
                <img src="~/images/no-photo.png" class="preview-thumb" alt="No photo" id="noPhotoPlaceholder" />
            }
        </div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="description"></label>
            <textarea asp-for="description" class="form-control"></textarea>
            <span asp-validation-for="description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="CategoryId"></label>
            <select asp-for="CategoryId" class="form-control"
                    asp-items="@(new SelectList(Model.FoodCategories ?? new List<WMS_Assignment.Models.FoodCategory>(), "Id", "Name"))">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Photos"></label>
            <input asp-for="Photos" type="file" multiple accept="image/*" class="form-control" onchange="previewPhoto(event)" />
            <span asp-validation-for="Photos" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-action btn-update">Save Changes</button>
            <a asp-action="AdminMenu" asp-controller="Admin" class="btn-action btn-cancel">Cancel</a>
        </div>

    </form>

    @if (hasPhoto)
    {
        foreach (var photo in Model.CurrentPhotoURL)
        {
            <form id="deleteForm_@photo.Id" asp-action="DeletePhoto" asp-controller="Admin" method="post" style="display:none;">
                <input type="hidden" name="photoId" value="@photo.Id" />
                <input type="hidden" name="menuItemId" value="@Model.Id" />
            </form>
        }
    }

</div>

<script>
    function previewPhoto(event) {
        const files = event.target.files;
        if (!files || files.length === 0) return;

        const placeholder = document.getElementById('noPhotoPlaceholder');
        if (placeholder) placeholder.remove();

        Array.from(files).forEach(file => {
            const img = document.createElement('img');
            img.src = URL.createObjectURL(file);
            img.className = 'preview-thumb new-photo';
            document.getElementById('photoPreviewContainer').appendChild(img);
        });
    }
</script>